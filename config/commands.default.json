{
  "version": 1,
  "commands": [
    {
      "id": "stop_recording",
      "enabled": true,
      "action": "stop_recording",
      "patterns": [
        "stop",
        "stop recording",
        "end dictation"
      ],
      "match_mode": "normalized_phrase",
      "remove_command_from_output": true
    },
    {
      "id": "newline",
      "enabled": true,
      "action": "insert_text",
      "value": "\n",
      "patterns": [
        "new line",
        "line break",
        "next line"
      ],
      "match_mode": "normalized_phrase",
      "remove_command_from_output": true
    },
    {
      "id": "tab",
      "enabled": true,
      "action": "insert_text",
      "value": "\t",
      "patterns": [
        "tabulation",
        "tab"
      ],
      "match_mode": "normalized_phrase",
      "remove_command_from_output": true
    }
  ]
}
